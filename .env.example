# =====================================================================
# Lava Thru — variáveis de ambiente
# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# (Projeto Supabase recomendado: plano Pro, região South America / São Paulo — sa-east-1)
# =====================================================================

# URL do projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon / publishable) — pode ir para o navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave de serviço (service_role / secret) — SÓ no servidor, NUNCA exponha.
# Usada para criar usuários (Auth) e o perfil correspondente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
